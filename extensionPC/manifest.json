{
  "manifest_version": 3,
  "name": "Alice WebSocket Client",
  "version": "1.0",
  "description": "WebSocket клиент для взаимодействия с Алисой",
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "scripting",
    "debugger",
    "activeTab",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Alice Client"
  }
}
